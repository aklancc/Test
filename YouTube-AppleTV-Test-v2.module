#!name=YouTube Apple TV Test v2
#!desc=Apple TV 兼容版：优化视频前贴片广告，保留正常视频播放及最小 MITM 范围

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
^https?://youtubei\.googleapis\.com/youtubei/v1/player/ad_break(?:[/?#]|$) _ reject-200
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?)).+&oad _ reject-200

[Script]
youtube_response=type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:[/?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/84477215bc16c39478203688fac8e2a943364c57/scripts/youtube-response.js,argument="{}"

[MITM]
hostname = %APPEND% youtubei.googleapis.com, -*.googlevideo.com, -www.youtube.com, -s.youtube.com
